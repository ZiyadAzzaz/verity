# ---------------------------------------------------------------------------
# LOCAL WORKSTATION TEMPLATE — copy this file to `.env`; never commit `.env`.
# ---------------------------------------------------------------------------
# The deployed Cloud Run service does NOT read this file. Cloud production receives non-secret
# settings from the service/job configuration and secrets from Google Secret Manager. Keeping
# VERITY_ENV=local here is therefore correct even while the public cloud deployment is live.
#
# local -> SQLite + asyncio queue + Docker sandbox + Gemini via AI Studio
# cloud -> Firestore + Pub/Sub + Cloud Run + Vertex adapters
#
# Do not switch a workstation to `cloud` merely to use the hosted site. Use the public URL and
# the dedicated judge key instead. Select `cloud` locally only for an explicitly authorized
# adapter/deployment operation with Google credentials and all production settings available.
VERITY_ENV=local

# ---------------------------------------------------------------------------
# VERITY_ENV=local
# ---------------------------------------------------------------------------
# Free key from https://aistudio.google.com/ — no billing account required.
GEMINI_API_KEY=
VERITY_SQLITE_PATH=verity.db
VERITY_SANDBOX_IMAGE=verity-sandbox-runner:1
VERITY_SANDBOX_AUTO_BUILD=true
VERITY_SANDBOX_MEMORY=4g
VERITY_SANDBOX_CPUS=2
# How many verifications may run at once. Each one starts containers; keep it at 1
# on a laptop unless you know you have the headroom.
VERITY_QUEUE_CONCURRENCY=1

# ---------------------------------------------------------------------------
# CLOUD-ONLY REFERENCE (normally leave these empty in a local `.env`)
# The live values are managed on Cloud Run / Cloud Run Jobs, not copied from this file.
# ---------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_VERTEX_LOCATION=global
VERITY_PUBSUB_TOPIC=verification-jobs
VERITY_CLOUD_RUN_SANDBOX_JOB=verity-sandbox
VERITY_CLOUD_RUN_PIPELINE_JOB=verity-pipeline
VERITY_PUBSUB_OIDC_AUDIENCE=
VERITY_PUBSUB_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
# development | test | production. `production` stays fail-closed until the live sandbox
# identity test passes and the guard removal is explicitly reviewed.
VERITY_ENVIRONMENT=development
VERITY_GEMINI_MODEL=gemini-3.5-flash
VERITY_API_KEY=replace-with-at-least-24-random-characters
# Optional second credential for judges/reviewers. It is independently revocable and must be
# different from VERITY_API_KEY. Never publish either value in Git, Markdown, screenshots, or
# chat. Production maps this name to Secret Manager secret `verity-judge-test-key`.
VERITY_JUDGE_TEST_KEY=
VERITY_MAX_DEBUG_ATTEMPTS=3
VERITY_EXECUTION_TIMEOUT_SECONDS=900

# GitHub reporter. Prefer a fine-grained token with Issues: write only.
# Leave empty locally: verdicts are still stored and shown, just not filed as Issues.
VERITY_GITHUB_TOKEN=
VERITY_REPORT_REPO=

# Individual backend overrides. Unset means "whatever VERITY_ENV implies".
# VERITY_STORE_BACKEND=memory|sqlite|firestore
# VERITY_MESSAGE_BACKEND=asyncio|pubsub
# VERITY_SANDBOX_BACKEND=docker|host_subprocess|cloud_run
# VERITY_LLM_BACKEND=ai_studio|vertex
#
# host_subprocess runs untrusted third-party code directly on your machine with no
# isolation. It exists for debugging Verity itself; do not point it at a repository
# you have not read.
