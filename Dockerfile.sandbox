FROM python:3.11.15-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/verity
COPY requirements-sandbox.txt ./
RUN python -m pip install --no-cache-dir -r requirements-sandbox.txt
COPY verity ./verity

RUN useradd --create-home --uid 10002 sandbox \
    && chown -R sandbox:sandbox /opt/verity
USER 10002

ENTRYPOINT ["python", "-m", "verity.sandbox_runner"]

